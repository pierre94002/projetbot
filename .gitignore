node_modules/
dist/
.env
.env.local

# Rapports d'analyse générés localement — pas de valeur à versionner
server/data/reports/

# Sauvegardes ponctuelles créées par les scripts de migration (server/scripts/)
# — redondant avec git une fois le commit fait, pas la peine d'alourdir le dépôt.
server/data/backups/

# server/data/runtime/ est suivi depuis le refactor sport/glass (checkpoint des
# vraies données paris/pronostics/résultats) — SAUF ai-config.json, qui
# contient une clé API en clair et ne doit jamais entrer dans l'historique.
server/data/runtime/ai-config.json

# Caches et instantanés réécrits en entier à chaque appel d'API : plusieurs Mo
# de bruit par commit, sans valeur d'historique (le cache se reconstruit tout
# seul, l'instantané de cotes se réactualise depuis Réglages > Données).
server/data/runtime/team-stats-cache.json
server/data/fixtures/odds/odds-snapshot.json

npm-debug.log*
.DS_Store
Thumbs.db

# Worktrees temporaires créés par les agents Explore/Plan isolés (isolation:
# "worktree") — pas toujours nettoyés automatiquement, jamais à versionner.
.claude/worktrees/

# Brut FlashScore (~110 Mo/journee) telecharge par scripts/import-flashscore-history.mjs
server/data/runtime/flashscore-raw/
server/data/runtime/_tmp-flashscore-import/
# Fichiers intermediaires de scripts/csv-to-season-data.mjs (regeneres a chaque run)
server/data/runtime/_tmp-season-import/

# CSV bruts football-data.co.uk (~14 Mo, 16 championnats x 5 saisons) : source
# gratuite et sans quota, retelechargeable a tout moment par
#   node server/scripts/import-historical-matches.js
# Les donnees derivees qui comptent (calendrier, classements) sont versionnees,
# elles, dans server/data/runtime/.
server/data/fixtures/historique/

# Verrou du rafraîchissement automatique des statistiques (cf.
# server/src/data/providers/espnMatchStatsRefresh.js) : état d'un processus
# en cours, propre à la machine, sans valeur d'historique.
server/data/runtime/espn-refresh.lock
