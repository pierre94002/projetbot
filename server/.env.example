PORT=4000
CORS_ORIGIN=http://localhost:5173

# Clé API-Sports (compte direct sur api-football.com, PAS RapidAPI).
# Sans elle, les endpoints /api/team-stats/* et l'enrichissement automatique
# des analyses de match renverront une erreur explicite (dégradation
# silencieuse côté analyse, erreur visible côté page Statistiques équipes).
# Plan gratuit : 100 requêtes/jour, saisons 2022-2024 uniquement.
API_FOOTBALL_KEY=

# Clé The Odds API (the-odds-api.com). Sans elle, /api/sources/odds/refresh
# échoue ; l'app continue de servir le dernier instantané local existant.
# Plan gratuit "Starter" : 500 crédits/mois.
ODDS_API_KEY=

# Clé football-data.org. Sans elle, /api/sources/competitions/refresh échoue ;
# l'app continue de servir le dernier instantané local existant.
# Plan gratuit : 12 compétitions, 10 requêtes/minute.
FOOTBALL_DATA_API_KEY=

# Clé SportMonks Football API v3 (api_token). Branchée pour exploration
# (/api/sportmonks/leagues) — le plan gratuit ne couvre pas les championnats
# déjà utilisés par CôteMaster, donc pas encore intégrée à l'analyse.
SPORTMONKS_API_KEY=

# Clé API Anthropic (console.anthropic.com), pour l'analyse IA des
# pronostics (Réglages > Connexion IA). Optionnelle : peut aussi être saisie
# depuis l'interface, qui est alors prioritaire si les deux sont définis.
# Sans elle et sans connexion via l'UI, /api/ai-analysis/run échoue avec un
# message explicite plutôt qu'une erreur générique.
ANTHROPIC_API_KEY=
# Optionnel — remplace claude-sonnet-5 par défaut si défini.
ANTHROPIC_MODEL=
# Optionnel — requis seulement pour les clés "identity-linked" liées à un
# workspace précis (l'API renvoie une erreur explicite si nécessaire et
# absent). Trouvable dans console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Jeton API Apify (console.apify.com > Settings > Integrations), pour
# l'actor FlashScore (statistiques d'équipe complémentaires : xG, possession,
# tirs, forme récente). Sans lui, Réglages > Données > "Actualiser
# FlashScore" échoue avec un message explicite ; le reste de l'app continue
# de fonctionner normalement (source strictement additive, jamais requise).
# ATTENTION : chaque actualisation a un coût réel (~0,01 $/match renvoyé,
# soit environ 2-3 $ pour une journée de football) — déclenchée uniquement à
# la main depuis Réglages, jamais automatiquement.
APIFY_API_TOKEN=
# Optionnel — remplace l'actor par défaut si défini (format "auteur/nom").
APIFY_FLASHSCORE_ACTOR=

# Rafraîchissement automatique des statistiques de match depuis l'API JSON
# publique d'ESPN. AUCUNE clé, aucun quota, aucun coût : contrairement aux
# fournisseurs ci-dessus, cette source est libre d'accès, donc la boucle est
# active par défaut. Mettre "false" pour la couper (l'app sert alors ce qui
# est déjà stocké, sans jamais se compléter).
MATCH_STATS_AUTO_REFRESH=
# Période entre deux passages, en minutes (défaut : 180).
MATCH_STATS_REFRESH_INTERVAL_MIN=
# Attente après le démarrage du serveur, en minutes (défaut : 2).
MATCH_STATS_REFRESH_DELAY_MIN=
# Nombre maximal de matchs traités par passage (défaut : 300).
MATCH_STATS_REFRESH_BATCH=
# Requêtes simultanées vers ESPN (défaut : 4).
MATCH_STATS_REFRESH_CONCURRENCY=
